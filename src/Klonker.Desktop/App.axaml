<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Klonker.Desktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <Color x:Key="SystemAccentColor">#3FB950</Color>
    <Color x:Key="SystemAccentColorLight1">#52CF6D</Color>
    <Color x:Key="SystemAccentColorLight2">#72DB87</Color>
    <Color x:Key="SystemAccentColorDark1">#329C42</Color>
    <Color x:Key="SystemAccentColorDark2">#247A32</Color>
    <SolidColorBrush x:Key="ChromeBrush" Color="#070B0E" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#090E12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0E151B" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#131C22" />
    <SolidColorBrush x:Key="InputBrush" Color="#0A1014" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A252D" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#173622" />
    <SolidColorBrush x:Key="BorderBrush" Color="#202D35" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#344650" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#173622" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BAC4CA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7F8D96" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#351B1E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E7B64C" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#302814" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#102B19" />

    <SolidColorBrush x:Key="FolderIconBrush" Color="#E7B64C" />
    <SolidColorBrush x:Key="CodeIconBrush" Color="#70AFFF" />
    <SolidColorBrush x:Key="MarkdownIconBrush" Color="#B59BFF" />
    <SolidColorBrush x:Key="BuildIconBrush" Color="#F09A6B" />
    <SolidColorBrush x:Key="ConfigurationIconBrush" Color="#55D6BE" />
    <SolidColorBrush x:Key="BinaryIconBrush" Color="#D28BD8" />
    <SolidColorBrush x:Key="FileIconBrush" Color="#93A2AC" />
    <SolidColorBrush x:Key="WindowsLogoBrush" Color="#55A7F7" />
    <SolidColorBrush x:Key="LinuxLogoBrush" Color="#F0C95B" />
    <SolidColorBrush x:Key="CMakeLogoBrush" Color="#EE6A6A" />
    <SolidColorBrush x:Key="MakeLogoBrush" Color="#64C7B8" />
    <SolidColorBrush x:Key="XmakeLogoBrush" Color="#B794F6" />
    <SolidColorBrush x:Key="CppLogoBrush" Color="#6CA4F5" />
    <SolidColorBrush x:Key="LuaLogoBrush" Color="#7B8CFF" />

    <!-- Vector icons are kept in one host-controlled set so views do not
         depend on font glyph availability or external icon assets. -->
    <StreamGeometry x:Key="IconTree">M4 3H12V8H9V11H18V8H15V3H23V8H20V13H9V16H12V21H4V16H7V8H4V3ZM6 5V6H10V5H6ZM17 5V6H21V5H17ZM6 18V19H10V18H6Z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M10 3A7 7 0 1 0 14.9 15L20 20.1L21.4 18.7L16.3 13.6A7 7 0 0 0 10 3ZM10 5A5 5 0 1 1 10 15A5 5 0 0 1 10 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconCode">M8.6 17.4L3.2 12L8.6 6.6L10 8L6 12L10 16L8.6 17.4ZM15.4 17.4L14 16L18 12L14 8L15.4 6.6L20.8 12L15.4 17.4Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlatform">M3 4H21A2 2 0 0 1 23 6V17A2 2 0 0 1 21 19H14V21H17V23H7V21H10V19H3A2 2 0 0 1 1 17V6A2 2 0 0 1 3 4ZM3 6V16H21V6H3Z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M12 2A10 10 0 1 0 12 22A10 10 0 0 0 12 2ZM10.2 16.2L6 12L7.4 10.6L10.2 13.4L16.6 7L18 8.4L10.2 16.2Z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowRight">M13 5L20 12L13 19L11.6 17.6L16.2 13H4V11H16.2L11.6 6.4L13 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconBack">M11 5L4 12L11 19L12.4 17.6L7.8 13H20V11H7.8L12.4 6.4L11 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconCursor">M4 2L19 13H12.5L16.5 21L13.8 22.3L9.8 14.3L5.5 19L4 2Z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M4 7H14V9H4V7ZM16 5H20V11H16V5ZM10 15H20V17H10V15ZM4 13H8V19H4V13Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M7 4V20L20 12L7 4Z</StreamGeometry>
    <StreamGeometry x:Key="IconError">M12 2A10 10 0 1 0 12 22A10 10 0 0 0 12 2ZM11 7H13V14H11V7ZM11 16H13V18H11V16Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M2 5H9L11 7H22A2 2 0 0 1 24 9V19A2 2 0 0 1 22 21H2A2 2 0 0 1 0 19V7A2 2 0 0 1 2 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M6 2H15L21 8V22H6A2 2 0 0 1 4 20V4A2 2 0 0 1 6 2ZM14 4V9H19L14 4Z</StreamGeometry>
    <StreamGeometry x:Key="IconCodeFile">M8 6L2 12L8 18L9.4 16.6L4.8 12L9.4 7.4L8 6ZM16 6L14.6 7.4L19.2 12L14.6 16.6L16 18L22 12L16 6Z</StreamGeometry>
    <StreamGeometry x:Key="IconDocument">M5 2H15L21 8V22H5A2 2 0 0 1 3 20V4A2 2 0 0 1 5 2ZM14 4V9H19M7 13H17V15H7V13ZM7 17H15V19H7V17Z</StreamGeometry>
    <StreamGeometry x:Key="IconBuild">M21.7 18.3L14.2 10.8A6 6 0 0 0 6.1 3.2L9.8 6.9L7 9.7L3.3 6A6 6 0 0 0 10.9 14.1L18.4 21.6A2.3 2.3 0 1 0 21.7 18.3Z</StreamGeometry>
    <StreamGeometry x:Key="IconConfigurationFile">M5 3H19V5H5V3ZM3 8H9V14H3V8ZM11 10H21V12H11V10ZM5 17H19V19H5V17Z</StreamGeometry>
    <StreamGeometry x:Key="IconBinaryFile">M12 2L21 7V17L12 22L3 17V7L12 2ZM12 4.3L6.2 7.5L12 10.7L17.8 7.5L12 4.3ZM5 9.2V15.8L11 19.1V12.5L5 9.2ZM13 19.1L19 15.8V9.2L13 12.5V19.1Z</StreamGeometry>
    <StreamGeometry x:Key="IconMinimize">M4 11H20V13H4V11Z</StreamGeometry>
    <StreamGeometry x:Key="IconMaximize">M4 4H20V20H4V4ZM6 7V18H18V7H6Z</StreamGeometry>
    <StreamGeometry x:Key="IconRestore">M7 3H21V17H18V21H3V7H7V3ZM9 7H18V14H17V7H9ZM6 10V18H15V10H6Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6.4 5L12 10.6L17.6 5L19 6.4L13.4 12L19 17.6L17.6 19L12 13.4L6.4 19L5 17.6L10.6 12L5 6.4L6.4 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12 2.8L14.8 8.5L21.1 9.4L16.6 13.8L17.6 20L12 17L6.4 20L7.4 13.8L2.9 9.4L9.2 8.5L12 2.8ZM12 7.3L10.5 10.4L7.1 10.9L9.5 13.2L8.9 16.6L12 15L15.1 16.6L14.5 13.2L16.9 10.9L13.5 10.4L12 7.3Z</StreamGeometry>
    <StreamGeometry x:Key="IconStarFilled">M12 2.8L14.8 8.5L21.1 9.4L16.6 13.8L17.6 20L12 17L6.4 20L7.4 13.8L2.9 9.4L9.2 8.5L12 2.8Z</StreamGeometry>
    <StreamGeometry x:Key="IconTag">M3 4A1 1 0 0 1 4 3H13L21 11L13 19L3 9V4ZM7 6A2 2 0 1 0 7 10A2 2 0 0 0 7 6Z</StreamGeometry>
    <StreamGeometry x:Key="IconBrowse">M3 5H10L12 7H21A2 2 0 0 1 23 9V18A2 2 0 0 1 21 20H3A2 2 0 0 1 1 18V7A2 2 0 0 1 3 5ZM3 9V18H21V9H3Z</StreamGeometry>
    <StreamGeometry x:Key="IconGenerate">M13 2L5 13H11L10 22L19 10H13V2Z</StreamGeometry>
    <StreamGeometry x:Key="IconPrevious">M15.5 5L8.5 12L15.5 19L16.9 17.6L11.3 12L16.9 6.4L15.5 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconNext">M8.5 5L15.5 12L8.5 19L7.1 17.6L12.7 12L7.1 6.4L8.5 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconExpandAll">M7 3L3 7L7 11L8.4 9.6L6.8 8H17.2L15.6 9.6L17 11L21 7L17 3L15.6 4.4L17.2 6H6.8L8.4 4.4L7 3ZM7 13L3 17L7 21L8.4 19.6L6.8 18H17.2L15.6 19.6L17 21L21 17L17 13L15.6 14.4L17.2 16H6.8L8.4 14.4L7 13Z</StreamGeometry>
    <StreamGeometry x:Key="IconCollapseAll">M8 3H16V5H8V3ZM5 8H19V10H5V8ZM5 14H19V16H5V14ZM8 19H16V21H8V19Z</StreamGeometry>
    <StreamGeometry x:Key="IconInfo">M12 2A10 10 0 1 0 12 22A10 10 0 0 0 12 2ZM11 7H13V9H11V7ZM11 11H13V17H11V11Z</StreamGeometry>
    <StreamGeometry x:Key="IconPackage">M3 6L12 2L21 6V18L12 22L3 18V6ZM12 4.2L6 6.9L12 9.6L18 6.9L12 4.2ZM5 8.5V16.7L11 19.3V11.3L5 8.5ZM13 19.3L19 16.7V8.5L13 11.3V19.3Z</StreamGeometry>
    <StreamGeometry x:Key="IconWindows">M2 4L11 2.7V11H2V4ZM13 2.4L22 1V11H13V2.4ZM2 13H11V21.3L2 20V13ZM13 13H22V23L13 21.6V13Z</StreamGeometry>
    <StreamGeometry x:Key="IconLinux">M12 2C9.7 2 8.2 4.2 8.2 7.1C8.2 8.7 7.6 9.7 6.7 11C5.4 12.9 5 15.2 5 18H8L7 21H10.8L12 19L13.2 21H17L16 18H19C19 15.2 18.6 12.9 17.3 11C16.4 9.7 15.8 8.7 15.8 7.1C15.8 4.2 14.3 2 12 2ZM10.2 6.4A1 1 0 1 1 10.2 8.4A1 1 0 0 1 10.2 6.4ZM13.8 6.4A1 1 0 1 1 13.8 8.4A1 1 0 0 1 13.8 6.4ZM9.5 12H14.5L12 15L9.5 12Z</StreamGeometry>
    <StreamGeometry x:Key="IconCMake">M12 2L2 21H22L12 2ZM12 6.5L18 18H6L12 6.5ZM12 10.5L8.7 17H15.3L12 10.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconMake">M4 3H13L18 8L15 11L12 8L7.5 12.5L11.5 16.5L7 21L3 17L7.5 12.5L5 10V8H3V3H4ZM7 5V7H10L12 9L15 8L12 5H7Z</StreamGeometry>
    <StreamGeometry x:Key="IconXmake">M4 3H8L12 9L16 3H20L14 12L20 21H16L12 15L8 21H4L10 12L4 3Z</StreamGeometry>
    <StreamGeometry x:Key="IconCppLanguage">M8.6 17.4L3.2 12L8.6 6.6L10 8L6 12L10 16L8.6 17.4ZM15.4 17.4L14 16L18 12L14 8L15.4 6.6L20.8 12L15.4 17.4Z</StreamGeometry>
    <StreamGeometry x:Key="IconLua">M11.7 3A8.7 8.7 0 1 0 20.4 11.7A8.7 8.7 0 0 0 11.7 3ZM11.7 6A5.7 5.7 0 1 1 6 11.7A5.7 5.7 0 0 1 11.7 6ZM18.8 2.2A2.1 2.1 0 1 0 20.9 4.3A2.1 2.1 0 0 0 18.8 2.2Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.successSurface">
      <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style Selector="Border.warningSurface">
      <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="Button.close:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.favorite">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.favorite:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource FolderIconBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#08110A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#52CF6D" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="ComboBox.field">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="#D8DEE4" />
    </Style>
  </Application.Styles>
</Application>
