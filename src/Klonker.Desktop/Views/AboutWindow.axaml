<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Klonker.Desktop.ViewModels"
        x:Class="Klonker.Desktop.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Width="760"
        Height="650"
        MinWidth="680"
        MinHeight="580"
        CanResize="True"
        Icon="avares://Klonker.Desktop/Assets/klonker.png"
        Title="About Klonker"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="18"
        RowDefinitions="*,Auto"
        RowSpacing="12">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Padding="24"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid ColumnDefinitions="132,*"
                ColumnSpacing="22">
            <Border Width="120"
                    Height="120"
                    Background="{StaticResource AccentMutedBrush}"
                    CornerRadius="24">
              <Image Margin="12"
                     Stretch="Uniform"
                     Source="avares://Klonker.Desktop/Assets/klonker.png" />
            </Border>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="7">
              <TextBlock FontSize="32"
                         FontWeight="Bold"
                         LetterSpacing="1.6"
                         Text="KLONKER" />
              <TextBlock Classes="secondary"
                         FontSize="15"
                         Text="A Windows-first project generator and detached template-authoring toolkit." />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Border Padding="8,4"
                        Background="{StaticResource SelectionBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                  <TextBlock FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="{Binding DisplayVersion}" />
                </Border>
                <Border Padding="8,4"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                  <TextBlock Classes="secondary"
                             FontSize="11"
                             Text="{Binding BuildChannel}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="12">
          <Border Classes="panel"
                  Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow"
                         Text="CREATED BY" />
              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Text="{x:Static vm:AboutViewModel.AuthorName}" />
              <TextBlock Classes="secondary"
                         TextWrapping="Wrap"
                         Text="Author and maintainer of Klonker." />
              <Button Classes="ghost"
                      HorizontalAlignment="Left"
                      Tag="{x:Static vm:AboutViewModel.AuthorUrl}"
                      Click="OnLinkClicked"
                      Content="View author on GitHub" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="panel"
                  Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow"
                         Text="OPEN SOURCE" />
              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Text="MIT License" />
              <TextBlock Classes="secondary"
                         TextWrapping="Wrap"
                         Text="Source, issue tracking, and development history are available on GitHub." />
              <Button Classes="ghost"
                      HorizontalAlignment="Left"
                      Tag="{x:Static vm:AboutViewModel.RepositoryUrl}"
                      Click="OnLinkClicked"
                      Content="Open Klonker repository" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="panel"
                Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow"
                       Text="WHAT KLONKER DOES" />
            <TextBlock Classes="secondary"
                       TextWrapping="Wrap"
                       Text="Klonker discovers reusable templates from trusted registries, collects declared values, previews deterministic output, and generates into a new or empty folder. It also provides guided template and registry authoring workflows." />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Generated projects are fully detached. Klonker does not install SDKs, execute template commands, build generated projects, initialize Git, or merge into existing project trees." />
          </StackPanel>
        </Border>

        <Border Classes="inset"
                Padding="14">
          <Grid ColumnDefinitions="150,*"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="8">
            <TextBlock Classes="eyebrow"
                       Text="VERSION" />
            <TextBlock Grid.Column="1"
                       FontFamily="Cascadia Mono,Consolas"
                       Text="{Binding FullVersion}" />
            <TextBlock Grid.Row="1"
                       Classes="eyebrow"
                       Text="RUNTIME" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding Runtime}" />
            <TextBlock Grid.Row="2"
                       Classes="eyebrow"
                       Text="PLATFORM" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       Text="{Binding Platform}" />
          </Grid>
        </Border>

        <StackPanel HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Classes="ghost"
                  Tag="{x:Static vm:AboutViewModel.DocumentationUrl}"
                  Click="OnLinkClicked"
                  Content="Documentation" />
          <Button Classes="ghost"
                  Tag="{x:Static vm:AboutViewModel.LicenseUrl}"
                  Click="OnLinkClicked"
                  Content="View license" />
        </StackPanel>

        <TextBlock HorizontalAlignment="Center"
                   Classes="muted"
                   FontSize="11"
                   Text="{Binding Copyright}" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto">
      <TextBlock Classes="muted"
                 VerticalAlignment="Center"
                 Text="Thank you for using Klonker." />
      <Button Grid.Column="1"
              Classes="primary"
              Click="OnCloseClicked"
              Content="Close" />
    </Grid>
  </Grid>
</Window>
