<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Klonker.Desktop.ViewModels"
        xmlns:views="using:Klonker.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Klonker.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="820"
        Width="1360"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowDecorations="BorderOnly"
        CanResize="True"
        Icon="avares://Klonker.Desktop/Assets/klonker.png"
        Title="Klonker">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="42,*">
    <Border Grid.Row="0"
            Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Margin="13,7"
               Width="28"
               Height="28"
               HorizontalAlignment="Left"
               Stretch="Uniform"
               Source="avares://Klonker.Desktop/Assets/klonker.png" />

        <StackPanel Grid.Column="1"
                    Margin="2,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock FontSize="13"
                     FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}"
                     LetterSpacing="1.6"
                     Text="K" />
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}"
                     LetterSpacing="2.1"
                     Text="LONKER" />
          <Border Margin="8,0,0,0"
                  Padding="6,2"
                  Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <TextBlock FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       LetterSpacing="0.7"
                       Text="PREVIEW" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="1">
          <Button AutomationProperties.Name="Registry workspace"
                  Classes="icon"
                  Click="OnRegistryWizardClicked"
                  ToolTip.Tip="Create, build, sign, or test a registry">
            <PathIcon Width="16"
                      Height="16"
                      Data="{StaticResource IconFolder}" />
          </Button>
          <Button AutomationProperties.Name="Template wizard"
                  Classes="icon"
                  Click="OnTemplateWizardClicked"
                  ToolTip.Tip="Create or inspect a template package">
            <PathIcon Width="16"
                      Height="16"
                      Data="{StaticResource IconPackage}" />
          </Button>
          <Button AutomationProperties.Name="Settings"
                  Classes="icon"
                  Click="OnSettingsClicked"
                  ToolTip.Tip="Settings">
            <PathIcon Width="15"
                      Height="15"
                       Data="{StaticResource IconSettings}" />
          </Button>
          <Button AutomationProperties.Name="About Klonker"
                  Classes="icon"
                  Click="OnAboutClicked"
                  ToolTip.Tip="About Klonker">
            <PathIcon Width="16"
                      Height="16"
                      Data="{StaticResource IconInfo}" />
          </Button>
          <Button AutomationProperties.Name="Minimize"
                  Classes="icon"
                  Click="OnMinimizeClicked"
                  ToolTip.Tip="Minimize">
            <PathIcon Width="14"
                      Height="14"
                      Data="{StaticResource IconMinimize}" />
          </Button>
          <Button AutomationProperties.Name="Maximize"
                  Classes="icon"
                  Click="OnMaximizeClicked"
                  ToolTip.Tip="Maximize">
            <Grid>
              <PathIcon x:Name="MaximizeIcon"
                        Width="13"
                        Height="13"
                        Data="{StaticResource IconMaximize}" />
              <PathIcon x:Name="RestoreIcon"
                        Width="13"
                        Height="13"
                        Data="{StaticResource IconRestore}"
                        IsVisible="False" />
            </Grid>
          </Button>
          <Button AutomationProperties.Name="Close"
                  Classes="icon close"
                  Click="OnCloseClicked"
                  ToolTip.Tip="Close">
            <PathIcon Width="14"
                      Height="14"
                      Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <views:CatalogView IsVisible="{Binding IsCatalogView}" />
      <views:ConfigurationView IsVisible="{Binding IsConfigurationView}" />
      <views:ModuleConfigurationView IsVisible="{Binding IsModuleConfigurationView}" />
    </Grid>
  </Grid>
</Window>
